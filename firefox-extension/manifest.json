{
  "manifest_version": 3,
  "name": "Tab Walker",
  "version": "0.0.1",
  "description": "Makes switching between tabs more convenient with recent tab ordering, scrollable list, and instant search.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "settings/index.html",
    "default_title": "Tab Walker Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-walker": {
      "description": "Open Tab Walker",
      "suggested_key": {
        "default": "Alt+Y"
      }
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-walker@example.com",
      "strict_min_version": "109.0"
    }
  }
}
