{
  "manifest_version": 3,
  "name": "Tab Walker",
  "version": "0.0.1",
  "description": "Makes switching between tabs more convenient with recent tab ordering, scrollable list, and instant search.",
  "permissions": [
    "favicon",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab Walker"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "commands": {
    "toggle-walker": {
      "description": "Open Tab Walker",
      "suggested_key": {
        "default": "Alt+Y"
      }
    }
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "/_favicon/*"
      ]
    }
  ]
}
